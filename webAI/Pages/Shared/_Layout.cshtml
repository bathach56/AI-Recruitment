<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RecruitAI</title>
    
    <!-- Google Fonts -->
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <script src="/js/theme.js"></script>
    <link rel="stylesheet" href="/css/enterprise.css">
</head>
<body>
    <header class="site-nav"><nav class="navbar navbar-expand-md py-3"><div class="container-fluid px-3 px-md-4" style="max-width:1380px">
 <a class="navbar-brand d-flex align-items-center gap-2" href="/"><span class="brand-symbol"><i class="bi bi-intersect" aria-hidden="true"></i></span>RecruitAI<span class="pro-label ms-2">PRO MATCH</span></a>
 <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#portalNavigation" aria-controls="portalNavigation" aria-expanded="false" aria-label="Mở điều hướng"><span class="navbar-toggler-icon"></span></button>
 <div class="collapse navbar-collapse" id="portalNavigation"><div class="navbar-nav ms-auto gap-md-2">
 <a class="nav-link active" aria-current="page" href="/Candidate">Ứng viên</a><a class="nav-link "  href="/Recruiter">Nhà tuyển dụng</a><a class="nav-link "  href="/Admin">Trạng thái hệ thống</a>
 </div></div></div></nav></header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">RecruitAI · AI hỗ trợ đối chiếu hồ sơ · Quyết định thuộc về người đánh giá</footer>
    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/matching.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
