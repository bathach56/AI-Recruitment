@page
@model IndexModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>RecruitAI - Nền tảng Tuyển dụng &amp; So khớp Hồ sơ Thông minh</title>

    <!-- Google Font: Plus Jakarta Sans -->

    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <style>
        :root {
            --bs-body-font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
            --bs-body-bg: #f8fafc;
            --bs-primary: #3b82f6;
            --card-border: #e2e8f0;
        }

        body {
            font-family: var(--bs-body-font-family);
            background-color: var(--bs-body-bg);
            color: #1e293b;
        }

        .navbar-public {
            background: #ffffff;
            border-bottom: 1px solid var(--card-border);
            position: sticky;
            top: 0;
            z-index: 1020;
        }

        .hero-section {
            background: radial-gradient(circle at 50% 0%, #eff6ff 0%, #f8fafc 70%);
            padding: 5rem 0 4rem 0;
            border-bottom: 1px solid var(--card-border);
        }

        .role-portal-card {
            background: #ffffff;
            border: 1px solid var(--card-border);
            border-radius: 16px;
            padding: 2.2rem;
            transition: all 0.25s ease;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
        .role-portal-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 24px -10px rgba(0, 0, 0, 0.08);
            border-color: #93c5fd;
        }

        .feature-icon-box {
            width: 52px;
            height: 52px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            margin-bottom: 1.25rem;
        }

        .badge-live-ai {
            background: #eff6ff;
            color: #1d4ed8;
            border: 1px solid #bfdbfe;
            padding: 6px 14px;
            border-radius: 999px;
            font-size: 0.8rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
    </style>
    <link rel="stylesheet" href="/css/theme.css">
    <script src="/js/theme.js"></script>
    <link rel="stylesheet" href="/css/enterprise.css">
</head>
<body>

    <!-- PUBLIC NAVBAR -->
    <header class="navbar-public py-3 px-3 px-md-5">
        <div class="container d-flex align-items-center justify-content-between">
            <a href="/" class="text-decoration-none d-flex align-items-center gap-2">
                <div class="bg-primary text-white rounded-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                    <i class="bi bi-cpu-fill fs-4"></i>
                </div>
                <div>
                    <span class="fw-bold fs-4 tracking-tight text-dark">RecruitAI</span><span class="pro-label ms-2">PRO MATCH</span>
                </div>
            </a>

            <div class="d-none d-md-flex align-items-center gap-4">
                <a href="#features" class="text-decoration-none text-secondary fw-semibold small">Mô hình AI</a>
                <a href="#portals" class="text-decoration-none text-secondary fw-semibold small">Không gian làm việc</a>
                <a href="#workflow" class="text-decoration-none text-secondary fw-semibold small">Quy trình</a>
            </div>

            <div class="d-flex align-items-center gap-2">
                <a href="/Login" class="btn btn-outline-secondary btn-sm px-3 rounded-3 fw-semibold">
                    Đăng nhập
                </a>
                <a href="/Register" class="btn btn-primary btn-sm px-3 rounded-3 fw-semibold shadow-sm">
                    Tạo tài khoản
                </a>
            </div>
        </div>
    </header>

    <!-- HERO SECTION -->
    <section class="hero-section text-center">
        <div class="container" style="max-width: 900px;">
            <div class="mb-3">
                <span class="badge-live-ai">
                    <i class="bi bi-stars text-primary"></i> Ứng dụng Xử lý Ngôn ngữ Tự nhiên &amp; Deep Learning
                </span>
            </div>
            
            <h1 class="display-5 fw-bold text-dark mb-3" style="line-height: 1.25;">
                Nền tảng Tuyển dụng <span class="gradient-text">Thông Minh</span> với <span class="text-primary">Explainable AI</span>
            </h1>
            
            <p class="lead text-muted mb-4 fs-6">
                Hệ thống phân tích và đánh giá mức độ tương thích giữa Hồ sơ ứng viên (CV) và Bản mô tả công việc (Job Description) dựa trên sự kết hợp giữa <strong>Sentence-BERT</strong>, <strong>TF-IDF</strong> và <strong>đối chiếu kỹ năng</strong>.
            </p>

            <div class="d-flex justify-content-center gap-3 flex-wrap">
                <a href="/Candidate" class="btn btn-primary px-4 py-2 fw-semibold rounded-3 shadow-sm d-flex align-items-center gap-2">
                    <i class="bi bi-person-workspace"></i> Dành cho Ứng viên
                </a>
                <a href="/Recruiter" class="btn btn-outline-primary px-4 py-2 fw-semibold rounded-3 d-flex align-items-center gap-2">
                    <i class="bi bi-buildings"></i> Dành cho Doanh nghiệp
                </a>
            </div>
        </div>
    </section>

    <!-- 3 SEPARATE ROLES SECTION -->
    <section class="py-5" id="portals">
        <div class="container" style="max-width: 1200px;">
            <div class="text-center mb-5">
                <h3 class="fw-bold text-dark mb-2">Không gian làm việc cho từng nhu cầu</h3>
                <p class="text-muted small">Phân tích hồ sơ bằng API AI; các chức năng tài khoản và quản lý nghiệp vụ đang được phát triển</p>
            </div>

            <div class="row g-4">
                
                <!-- PORTAL 1: CANDIDATE -->
                <div class="col-12 col-md-4">
                    <div class="role-portal-card">
                        <div>
                            <div class="feature-icon-box bg-success-subtle text-success"><svg viewBox="0 0 24 24" aria-hidden="true"><circle class="icon-tone" cx="12" cy="8" r="4"/><circle cx="12" cy="8" r="4"/><path class="icon-tone" d="M4 21v-2a8 8 0 0 1 16 0v2Z"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/></svg>
                            </div>
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill mb-2 small fw-semibold">
                                Dành cho Candidate
                            </span>
                            <h4 class="fw-bold text-dark mb-2">Cổng Ứng viên (Candidate)</h4>
                            <p class="text-muted small mb-3">
                                Nhập yêu cầu công việc và tải CV thực tế để xem mức độ tương đồng cùng bằng chứng kỹ năng.
                            </p>
                            <ul class="list-unstyled small text-secondary mb-4">
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Nhập mô tả công việc cần đối chiếu</li>
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>AI Pre-screening &amp; Báo cáo Skill Gap</li>
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Xem văn bản trích xuất từ PDF/DOCX</li>
                            </ul>
                        </div>
                        <a href="/Candidate" class="btn btn-outline-success w-100 fw-semibold rounded-3">
                            Truy cập Cổng Ứng viên &rarr;
                        </a>
                    </div>
                </div>

                <!-- PORTAL 2: RECRUITER -->
                <div class="col-12 col-md-4">
                    <div class="role-portal-card">
                        <div>
                            <div class="feature-icon-box bg-primary-subtle text-primary"><svg viewBox="0 0 24 24" aria-hidden="true"><path class="icon-tone" d="M4 21V3h12v18Z"/><path d="M4 21V3h12v18M16 9h4v12M2 21h20M8 7h4M8 11h4M8 15h4M9 21v-3h2v3"/></svg>
                            </div>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 rounded-pill mb-2 small fw-semibold">
                                Dành cho Recruiter
                            </span>
                            <h4 class="fw-bold text-dark mb-2">Cổng Doanh nghiệp (Recruiter)</h4>
                            <p class="text-muted small mb-3">
                                Đối chiếu nhiều CV thực tế với cùng một JD, xem điểm thành phần và bằng chứng để hỗ trợ rà soát.
                            </p>
                            <ul class="list-unstyled small text-secondary mb-4">
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-primary me-2"></i>Nhập JD và yêu cầu kỹ năng</li>
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-primary me-2"></i>Phân tích lần lượt các CV được tải lên</li>
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-primary me-2"></i>Xem điểm thành phần và bằng chứng</li>
                            </ul>
                        </div>
                        <a href="/Recruiter" class="btn btn-primary w-100 fw-semibold rounded-3 shadow-sm">
                            Truy cập Cổng Doanh nghiệp &rarr;
                        </a>
                    </div>
                </div>

                <!-- PORTAL 3: ADMIN -->
                <div class="col-12 col-md-4">
                    <div class="role-portal-card">
                        <div>
                            <div class="feature-icon-box bg-dark text-warning"><svg viewBox="0 0 24 24" aria-hidden="true"><path class="icon-tone" d="m12 3 8 3v6c0 5-8 9-8 9S4 17 4 12V6Z"/><path d="m12 3 8 3v6c0 5-8 9-8 9S4 17 4 12V6Z"/><path d="m8 12 3 3 5-6"/></svg>
                            </div>
                            <span class="badge text-bg-dark border px-2 py-1 rounded-pill mb-2 small fw-semibold">
                                System Status
                            </span>
                            <h4 class="fw-bold text-dark mb-2">Cổng Quản trị (Admin)</h4>
                            <p class="text-muted small mb-3">
                                Kiểm tra kết nối dịch vụ matching và xem trạng thái các chức năng hệ thống.
                            </p>
                            <ul class="list-unstyled small text-secondary mb-4">
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-dark me-2"></i>Kiểm tra trạng thái kết nối AI</li>
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-dark me-2"></i>Xem phương pháp và trọng số mặc định</li>
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-dark me-2"></i>Thông tin về các chức năng đang phát triển</li>
                            </ul>
                        </div>
                        <a href="/Admin" class="btn btn-outline-dark w-100 fw-semibold rounded-3">
                            Truy cập Cổng Quản trị &rarr;
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- RESEARCH HIGHLIGHTS -->
    <section class="py-5 bg-white border-top border-bottom" id="features">
        <div class="container" style="max-width: 1000px;">
            <div class="text-center mb-5">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill small fw-semibold mb-2">
                    Nghiên cứu &amp; Thực nghiệm
                </span>
                <h3 class="fw-bold text-dark">Phương pháp So khớp Đa tầng (Hybrid NLP)</h3>
                <p class="text-muted small">Đồ án thực nghiệm so sánh khoa học giữa các giải pháp NLP truyền thống và mô hình học sâu ngữ nghĩa</p>
            </div>

            <div class="row g-4 text-center">
                <div class="col-md-4">
                    <div class="p-3">
                        <div class="fs-1 text-primary mb-2"><i class="bi bi-file-earmark-code"></i></div>
                        <h6 class="fw-bold text-dark">1. TF-IDF (Baseline)</h6>
                        <p class="text-muted small">Trích xuất vector từ khóa tần suất cao, tính độ đo Cosine Similarity cơ sở với tốc độ xử lý nhanh.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3">
                        <div class="fs-1 text-success mb-2"><i class="bi bi-diagram-3"></i></div>
                        <h6 class="fw-bold text-dark">2. Sentence-BERT</h6>
                        <p class="text-muted small">Biểu diễn ngữ cảnh sâu của câu văn, thấu hiểu ngữ nghĩa giữa mô tả ứng viên và yêu cầu nhiệm vụ của JD.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3">
                        <div class="fs-1 text-warning mb-2"><i class="bi bi-pie-chart"></i></div>
                        <h6 class="fw-bold text-dark">3. Hybrid Model</h6>
                        <p class="text-muted small">Kết hợp linh hoạt: 50% Ngữ nghĩa + 30% Kỹ năng + 20% Kinh nghiệm. Trọng số khởi đầu chưa được tối ưu bằng thực nghiệm.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="py-5" id="workflow"><div class="container text-center"><span class="eyebrow">BẮT ĐẦU TRONG 3 BƯỚC</span><h2 class="h4 mt-2 mb-4">Từ CV và JD đến kết quả có bằng chứng.</h2><div class="empty-steps"><span>01 · Nhập yêu cầu công việc</span><span>02 · Tải CV thực tế</span><span>03 · Phân tích và rà soát</span></div><a href="/Candidate" class="btn btn-primary mt-4 px-4">Bắt đầu phân tích</a></div></section>
    <!-- FOOTER -->
    <footer class="py-4 bg-light text-center small text-muted">
        <div class="container">
            <div>&copy; 2026 RecruitAI — Đồ án Tốt nghiệp Đại học: Hệ thống AI Hỗ trợ Tuyển dụng &amp; So khớp Hồ sơ.</div>
            <div class="mt-1">Công nghệ: ASP.NET Core &bull; SQL Server &bull; Python AI Service &bull; Bootstrap 5.3</div>
        </div>
    </footer>

    <!-- Bootstrap 5.3 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
