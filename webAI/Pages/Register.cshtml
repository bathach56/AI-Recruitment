@page
@model RegisterModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#312e81">
<title>Đăng ký tài khoản · RecruitAI</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Sora:wght@400;500;600;700&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
<link rel="stylesheet" href="/css/theme.css">
<link rel="stylesheet" href="/css/enterprise.css">
<link rel="stylesheet" href="/css/product.css">
<script src="/js/personalization.js" defer></script>
<script src="/js/theme.js">
</script>
</head>
<body class="">
<a class="skip-link" href="#main-content">Đến nội dung chính</a>
<header class="site-nav">
<nav class="navbar navbar-expand-lg">
<div class="nav-inner">
<a class="brand" href="/" aria-label="RecruitAI — Trang chủ">
<span class="brand-mark" aria-hidden="true">
<i class="bi bi-intersect">
</i>
</span>RecruitAI<span class="brand-caption">Tuyển dụng có căn cứ.</span>
</a>
<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#portalNavigation" aria-controls="portalNavigation" aria-expanded="false" aria-label="Mở điều hướng">
<span class="navbar-toggler-icon">
</span>
</button>
<div class="collapse navbar-collapse" id="portalNavigation">
<div class="navbar-nav">
<a href="/" class="nav-link " >Trang chủ</a>
<a href="/Candidate" class="nav-link " >Hồ sơ ứng viên</a>
<a href="/Recruiter" class="nav-link " >Không gian tuyển dụng</a>
<a href="/Admin" class="nav-link " >Trạng thái hệ thống</a>
</div>
<div class="nav-tools">
<a class="account-link" href="/Login">Tài khoản</a>
<span id="themeControl">
</span>
</div>
</div>
</div>
</nav>
</header>
<main id="main-content" class="container-wide account-page">
<section class="account-intro">
<h1>Đăng ký tài khoản</h1>
<p class="account-lead">Một góc nhìn rõ hơn<br>về từng hồ sơ.</p>
<p>Đối chiếu CV với yêu cầu công việc và xem bằng chứng trước khi đánh giá.</p>
<a class="text-link" href="/Recruiter">Mở không gian tuyển dụng <i class="bi bi-arrow-right" aria-hidden="true">
</i>
</a>
<div class="account-scope">
<h2>Bạn vẫn có thể bắt đầu</h2>
<p>Không gian đối chiếu CV đang mở. Tài khoản và lưu lịch sử sẽ khả dụng khi backend được tích hợp.</p>
</div>
</section>
<section class="account-form">
<h2>Đăng ký tài khoản</h2>
<div class="alert alert-info auth-unavailable" role="status">
<strong>Tài khoản chưa khả dụng.</strong>
<p>Đăng nhập, đăng ký và xác thực Google đang chờ API backend.</p>
<a href="/Recruiter">Đối chiếu hồ sơ ngay</a>
</div>
<details class="account-preview"><summary>Xem trước biểu mẫu tài khoản</summary>
<form id="registerForm" novalidate>
<fieldset disabled>

                            <!-- Full Name -->
                            <div class="mb-3">
                                <label for="fullName" class="form-label small fw-semibold text-dark">Họ và Tên</label>
                                <div class="input-group">
                                    <span class="input-group-text">
<i class="bi bi-person">
</i>
</span>
                                    <input type="text" class="form-control" id="fullName" placeholder="Họ tên của bạn" required autocomplete="name">
                                </div>
                                <div class="text-danger small mt-1" id="nameError" style="display:none;">
</div>
                            </div>

                            <!-- Email -->
                            <div class="mb-3">
                                <label for="email" class="form-label small fw-semibold text-dark">Địa chỉ Email</label>
                                <div class="input-group">
                                    <span class="input-group-text">
<i class="bi bi-envelope">
</i>
</span>
                                    <input type="email" class="form-control" id="email" placeholder="name@domain.com" required autocomplete="email">
                                </div>
                                <div class="text-danger small mt-1" id="emailError" style="display:none;">
</div>
                            </div>

                            <!-- Optional Company / Title (Dynamic) -->
                            <div class="mb-3" id="companyFieldGroup">
                                <label for="companyName" class="form-label small fw-semibold text-dark">Tên Công ty / Tổ chức</label>
                                <div class="input-group">
                                    <span class="input-group-text">
<i class="bi bi-building">
</i>
</span>
                                    <input type="text" class="form-control" id="companyName" placeholder="Tên tổ chức của bạn" autocomplete="organization">
                                </div>
                            </div>

                            <!-- Password -->
                            <div class="mb-2">
                                <label for="password" class="form-label small fw-semibold text-dark">Mật khẩu</label>
                                <div class="input-group">
                                    <span class="input-group-text">
<i class="bi bi-lock">
</i>
</span>
                                    <input type="password" class="form-control" id="password" placeholder="Tối thiểu 8 ký tự" required autocomplete="new-password">
                                    <button class="btn btn-outline-secondary input-group-text bg-white" type="button"  title="Hiện/Ẩn mật khẩu">
                                        <i class="bi bi-eye">
</i>
                                    </button>
                                </div>
                                <div class="text-danger small mt-1" id="passwordError" style="display:none;">
</div>
                            </div>

                            <!-- Password Strength Meter -->
                            <div class="mb-3">
                                <div class="d-flex align-items-center justify-content-between mb-1">
                                    <small class="text-muted" style="font-size: 0.75rem;">Độ an toàn mật khẩu:</small>
                                    <small class="fw-semibold" id="strengthText" style="font-size: 0.75rem; color: #94a3b8;">Chưa nhập</small>
                                </div>
                                <div class="strength-track">
                                    <div class="strength-segment" id="seg1">
</div>
                                    <div class="strength-segment" id="seg2">
</div>
                                    <div class="strength-segment" id="seg3">
</div>
                                    <div class="strength-segment" id="seg4">
</div>
                                </div>
                            </div>

                            <!-- Confirm Password -->
                            <div class="mb-3">
                                <label for="confirmPassword" class="form-label small fw-semibold text-dark">Xác nhận mật khẩu</label>
                                <div class="input-group">
                                    <span class="input-group-text">
<i class="bi bi-shield-lock">
</i>
</span>
                                    <input type="password" class="form-control" id="confirmPassword" placeholder="Nhập lại mật khẩu" required autocomplete="new-password">
                                </div>
                                <div class="text-danger small mt-1" id="confirmError" style="display:none;">
</div>
                            </div>

                            <!-- Terms and Condition Checkbox -->
                            <div class="mb-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="agreeTerms" required>
                                    <label class="form-check-label small text-muted" for="agreeTerms">
                                        Tôi đồng ý với <a href="#" class="text-primary text-decoration-none" data-unavailable-action="true" tabindex="-1" aria-disabled="true">Điều khoản dịch vụ</a> và <a href="#" class="text-primary text-decoration-none" data-unavailable-action="true" tabindex="-1" aria-disabled="true">Chính sách bảo mật</a>
                                    </label>
                                </div>
                                <div class="text-danger small mt-1" id="termsError" style="display:none;">
</div>
                            </div>

                            <!-- Submit Button -->
                            <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold mb-3 d-flex align-items-center justify-content-center gap-2" id="submitBtn">
                                <span class="btn-text">Đăng ký tài khoản</span>
                                <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true" id="submitSpinner">
</span>
                            </button>
                        </fieldset>
</form>
<button type="button" class="btn btn-outline-secondary w-100" data-unavailable-action="true" disabled>Tiếp tục với Google — chưa khả dụng</button>
</details>
<p class="account-switch">Đã có tài khoản? <a href="/Login">Xem trang đăng nhập</a>
</p>
</section>
</main>
<footer class="site-footer">
<a href="/">RecruitAI</a>
<span>AI hỗ trợ đối chiếu. Con người đưa ra quyết định.</span>
<a href="/Admin">Trạng thái dịch vụ <i class="bi bi-arrow-up-right" aria-hidden="true">
</i>
</a>
</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>
<script src="/js/account.js" defer>
</script>
</body>
</html>
