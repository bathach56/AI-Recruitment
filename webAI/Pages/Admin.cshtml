@page
@model AdminModel
@{ Layout = "_CareerLayout"; ViewData["Title"] = "Trạng thái hệ thống"; }
@section VendorStyles {
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
<link rel="stylesheet" href="/css/theme.css" asp-append-version="true">
<link rel="stylesheet" href="/css/enterprise.css" asp-append-version="true">
<link rel="stylesheet" href="/css/product.css" asp-append-version="true">
}
<div class="container system-refresh">
<div class="workspace-heading"><div><h1>Trạng thái hệ thống</h1><p>Theo dõi kết nối hiện tại trước khi đối chiếu hồ sơ của bạn.</p></div><div class="connection-panel"><span id="serviceStatus" class="connection-badge" role="status">Đang kiểm tra…</span><button class="btn btn-primary" id="refreshService" type="button"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i>Kiểm tra lại</button></div></div>
<div class="status-grid"><section class="surface-card status-metric"><i class="bi bi-code-slash" aria-hidden="true"></i><h2>Web API</h2><p id="webApiStatus" class="status-pill" role="status">Đang kiểm tra</p></section><section class="surface-card status-metric"><i class="bi bi-layers" aria-hidden="true"></i><h2>AI Service</h2><p id="aiApiStatus" class="status-pill" role="status">Đang kiểm tra</p></section><section class="surface-card status-metric"><i class="bi bi-cpu" aria-hidden="true"></i><h2>Trạng thái mô hình</h2><p>Chưa có API kiểm tra riêng</p></section><section class="surface-card status-metric"><i class="bi bi-stopwatch" aria-hidden="true"></i><h2>Phản hồi kiểm tra kết nối</h2><p><strong id="healthLatency">—</strong></p><small class="text-secondary">Web → AI → Web</small></section></div>
<div class="status-dashboard"><section class="surface-card"><h2><i class="bi bi-activity" aria-hidden="true"></i> Thời gian kiểm tra kết nối</h2><p>Các lần kiểm tra thành công trong trang đang mở, đơn vị ms.</p><div id="latencyChart" class="chart-empty" role="status">Cần ít nhất 2 lần kiểm tra thành công để vẽ biểu đồ.</div><p id="latencyRange" class="form-text mt-3"></p></section><section class="surface-card"><h2><i class="bi bi-clipboard-data" aria-hidden="true"></i> Đánh giá mô hình</h2><div class="research-notice"><strong>Chưa có kết quả thực nghiệm đã xác thực</strong><p>Precision, Recall và F1-score cần tập đánh giá có nhãn. Điểm đối chiếu CV không phải độ chính xác của mô hình.</p></div><div class="model-status-list"><div><span>TF-IDF</span><span class="text-secondary">Từ vựng</span></div><div><span>Sentence-BERT</span><span class="text-secondary">Ngữ nghĩa</span></div><div><span>Hybrid</span><span class="text-secondary">Nhiều thành phần</span></div></div></section></div>
<div class="status-dashboard"><section class="surface-card"><h2>Nhật ký kiểm tra của bạn</h2><ul id="healthLog" class="health-log" aria-live="polite"><li>Chưa có lần kiểm tra hoàn tất.</li></ul></section><section class="surface-card"><h2>Phạm vi hiện tại</h2><dl class="capability-list"><div><dt>Phân tích</dt><dd>Văn bản, PDF và DOCX</dd></div><div><dt>Kích thước tệp</dt><dd>Tối đa 10 MiB</dd></div><div><dt>PDF scan / OCR</dt><dd>Chưa hỗ trợ</dd></div><div><dt>Lưu kết quả</dt><dd>Trong trang · tải JSON</dd></div></dl><a class="text-link mt-3" href="/">Về trang chủ <i class="bi bi-arrow-right" aria-hidden="true"></i></a></section></div>
<p class="availability-note">Trạng thái trên đây được lấy từ lần kiểm tra kết nối hiện tại; không phải kết quả đánh giá mô hình.</p></div>
@section Scripts {
<script src="/js/status.js" asp-append-version="true" defer></script>
<script src="/js/matching.js" asp-append-version="true" defer></script>
}
